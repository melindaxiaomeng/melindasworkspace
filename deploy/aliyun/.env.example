# 复制本文件为 .env 并填入你的令牌（这就是看板登录密码）
API_TOKEN=请换成你的强随机串_例如openssl_rand_hex_24生成

# ===== AI 异常诊断 / 自动摘要（可选，不填则看板不显示 AI 功能）=====
# 大模型供应商（默认 DeepSeek，兼容 OpenAI 协议）
AI_API_KEY=你的DeepSeek_API_Key
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# Embedding（向量检索）。注意：DeepSeek 暂无 embedding 模型！
# 留空 = 用本地 TF-IDF 向量（零依赖，够用）；想更强语义检索可填下方免费/兼容服务：
#   SiliconFlow（推荐，国内直连，免费）：AI_EMBED_BASE_URL=https://api.siliconflow.cn/v1  AI_EMBED_MODEL=BAAI/bge-m3  AI_EMBED_API_KEY=你的SiliconFlow_Key
#   OpenAI：AI_EMBED_BASE_URL=https://api.openai.com/v1  AI_EMBED_MODEL=text-embedding-3-small  AI_EMBED_API_KEY=你的OpenAI_Key
AI_EMBED_API_KEY=
AI_EMBED_BASE_URL=
AI_EMBED_MODEL=

# 本地体验用：设 1 走 Mock 模式（不调真实模型，返回示例结果），仅本地调试，线上不要开
AI_MOCK=0
